@model IEnumerable<TP2.Models.Order>
@{
    ViewData["Title"] = "Toutes les Commandes";
}

<div class="container py-3">
    <h2 class="mb-4 text-primary">📋 Gestion Globale des Commandes</h2>

    <div class="table-responsive">
        <table class="table table-hover align-middle shadow-sm bg-white rounded">
            <thead class="table-dark">
                <tr>
                    <th># N°</th>
                    <th>Client</th>
                    <th>Email</th>
                    <th>Date</th>
                    <th>Montant Total</th>
                    <th>Adresse</th>
                    <th class="text-center">Action</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var order in Model)
                {
                    <tr>
                        <td><strong>#@order.Id</strong></td>
                        <td>@order.CustomerName</td>

                        <td>@order.OrderDate.ToString("dd/MM/yyyy HH:mm")</td>
                        <td><strong class="text-success">@order.TotalAmount.ToString("N2") DT</strong></td>
                        <td>@order.Address</td>
                        <td class="text-center">
                            <a asp-action="Details" asp-route-id="@order.Id" class="btn btn-sm btn-info text-white">
                                🔍 Détails
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>