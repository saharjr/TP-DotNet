@{
    ViewData["Title"] = "Paiement Annulé";
}

<div class="container text-center py-5">
    <div class="card shadow-sm mx-auto p-4 border-0" style="max-width: 500px;">
        <div class="fs-1 text-warning mb-2">⚠️</div>
        <h3 class="fw-bold mb-3">Paiement Annulé</h3>
        <p class="text-muted">
            Le paiement n'a pas été finalisé. Votre panier a été conservé.
        </p>
        <div class="mt-3">
            <a asp-controller="Panier" asp-action="Index" class="btn btn-primary me-2">
                🛒 Retourner au Panier
            </a>
            <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary">
                Accueil
            </a>
        </div>
    </div>
</div>