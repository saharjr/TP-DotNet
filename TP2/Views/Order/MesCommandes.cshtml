@model IEnumerable<TP2.Models.Order>
@{
    ViewData["Title"] = "Mes Commandes";
}

<div class="container py-3">
    <h2 class="mb-4 text-primary">📦 Mon Historique de Commandes</h2>

    @if (!Model.Any())
    {
        <div class="text-center py-5">
            <img src="~/images/panier_vide.png" alt="Aucune commande" style="width:150px;" class="mb-3" />
            <h4 class="text-muted">Vous n'avez pas encore passé de commande.</h4>
            <a asp-controller="Product" asp-action="Index" class="btn btn-primary mt-3">Découvrir nos produits</a>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle shadow-sm bg-white rounded">
                <thead class="table-primary">
                    <tr>
                        <th>N° Commande</th>
                        <th>Date</th>
                        <th>Articles</th>
                        <th>Montant Total</th>
                        <th>Adresse de livraison</th>
                        <th class="text-center">Action</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var order in Model)
                    {
                        <tr>
                            <td><strong>#@order.Id</strong></td>
                            <td>@order.OrderDate.ToString("dd/MM/yyyy HH:mm")</td>
                            <td><span class="badge bg-secondary">@(order.OrderItems?.Sum(i => i.Quantity) ?? 0) article(s)</span></td>
                            <td><strong class="text-success">@order.TotalAmount.ToString("N2") DT</strong></td>
                            <td>@order.Address</td>
                            <td class="text-center">
                                <a asp-action="Details" asp-route-id="@order.Id" class="btn btn-sm btn-outline-primary">
                                    🔍 Voir le détail
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>