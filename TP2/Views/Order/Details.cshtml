@model TP2.Models.Order

@{
    ViewData["Title"] = "Détail de la Commande #" + Model.Id;
}

<div class="container py-3">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>📦 Détail de la Commande #@Model.Id</h2>

        <div>
            <!-- Bouton Télécharger Facture PDF -->
            <a asp-action="Invoice" asp-route-id="@Model.Id" target="_blank" class="btn btn-danger me-2">
                📄 Imprimer / Enregistrer Facture PDF
            </a>

            @if (User.IsInRole("Admin") || User.IsInRole("Manager"))
            {
                <a asp-action="AllOrders" class="btn btn-outline-secondary">
                    ← Retour à toutes les commandes
                </a>
            }
            else
            {
                <a asp-action="MesCommandes" class="btn btn-outline-secondary">
                    ← Retour à mes commandes
                </a>
            }
        </div>
    </div>

    <div class="row g-4 mb-4">
        <div class="col-md-6">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0">Informations Client & Livraison</h5>
                </div>
                <div class="card-body">
                    <p><strong>Nom Client :</strong> @Model.CustomerName</p>
                    <p><strong>Adresse de livraison :</strong> @Model.Address</p>
                    <p><strong>Téléphone :</strong> @Model.Phone</p>
                    <p>
                        <strong>Statut du paiement :</strong>
                        <span class="badge bg-@(Model.PaymentStatus == "Payée" ? "success" : "warning")">
                            @Model.PaymentStatus
                        </span>
                    </p>
                    <p class="mb-0"><strong>Date de commande :</strong> @Model.OrderDate.ToString("dd/MM/yyyy à HH:mm")</p>
                </div>
            </div>
        </div>

        <div class="col-md-6">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-header bg-success text-white">
                    <h5 class="mb-0">Récapitulatif Financier</h5>
                </div>
                <div class="card-body d-flex flex-column justify-content-center text-center">
                    <h6 class="text-muted">Montant Total Réglé</h6>
                    <h2 class="text-success fw-bold">@Model.TotalAmount.ToString("N2") DT</h2>
                </div>
            </div>
        </div>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-header bg-dark text-white">
            <h5 class="mb-0">Articles commandés</h5>
        </div>
        <div class="card-body p-0">
            <table class="table table-striped mb-0">
                <thead>
                    <tr>
                        <th>Produit</th>
                        <th class="text-center">Quantité</th>
                        <th class="text-end">Prix Unitaire</th>
                        <th class="text-end">Total Ligne</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.OrderItems != null && Model.OrderItems.Any())
                    {
                        @foreach (var item in Model.OrderItems)
                        {
                            <tr>
                                <td><strong>@item.ProductName</strong></td>
                                <td class="text-center">@item.Quantity</td>
                                <td class="text-end">@item.Price.ToString("N2") DT</td>
                                <td class="text-end fw-bold">@((item.Price * item.Quantity).ToString("N2")) DT</td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="4" class="text-center py-3 text-muted">Aucun article dans cette commande.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>