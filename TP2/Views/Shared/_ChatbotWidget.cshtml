@using Microsoft.AspNetCore.Identity
@inject SignInManager<IdentityUser> SignInManager

<!-- Bouton Flottant (Chatbot Toggle) -->
<button id="chatbot-toggle-btn" class="btn btn-primary rounded-circle shadow-lg position-fixed bottom-0 end-0 m-4 d-flex align-items-center justify-content-center" style="width: 55px; height: 55px; z-index: 1050;" onclick="toggleChatbot()">
    <span id="chatbot-icon" style="font-size: 24px;">💬</span>
</button>

<!-- Fenêtre du Chatbot -->
<div id="chatbot-window" class="card shadow-lg position-fixed bottom-0 end-0 m-4 d-none flex-column" style="width: 350px; height: 460px; z-index: 1050; border-radius: 15px; overflow: hidden;">
    
    <!-- En-tête -->
    <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center py-2 px-3">
        <div class="d-flex align-items-center gap-2">
            <span style="font-size: 20px;">🤖</span>
            <span class="fw-bold fs-6">Assistant E-Shop</span>
        </div>
        <button type="button" class="btn-close btn-close-white" onclick="toggleChatbot()"></button>
    </div>

    <!-- Zone des Messages -->
    <div id="chatbot-messages" class="card-body p-3 overflow-auto d-flex flex-column gap-2" style="background-color: #f8f9fa; flex: 1;">
        <div class="d-flex align-items-start gap-2 mb-2">
            <div class="bg-white p-2 rounded shadow-sm text-dark border" style="max-width: 85%; font-size: 13px;">
                Bonjour ! 👋 Je suis l'assistant virtuel E-Shop. Comment puis-je vous aider ?
            </div>
        </div>
    </div>

    <!-- Suggestions Rapides -->
    <div id="chatbot-suggestions" class="px-2 py-1 bg-light border-top d-flex flex-wrap gap-1" style="font-size: 11px;">
        @if (User.IsInRole("Admin") || User.IsInRole("Manager"))
        {
            <button class="btn btn-outline-secondary btn-sm py-0 px-2" onclick="sendQuickMessage('Chiffre d\'affaires')">📊 CA</button>
            <button class="btn btn-outline-secondary btn-sm py-0 px-2" onclick="sendQuickMessage('Produits en rupture')">⚠️ Ruptures</button>
            <button class="btn btn-outline-secondary btn-sm py-0 px-2" onclick="sendQuickMessage('Dernières commandes')">📋 Commandes</button>
        }
        else
        {
            <button class="btn btn-outline-secondary btn-sm py-0 px-2" onclick="sendQuickMessage('Où est ma commande ?')">📦 Ma commande</button>
            <button class="btn btn-outline-secondary btn-sm py-0 px-2" onclick="sendQuickMessage('Frais de livraison')">🚚 Livraison</button>
            <button class="btn btn-outline-secondary btn-sm py-0 px-2" onclick="sendQuickMessage('Voir le catalogue')">🛍️ Catalogue</button>
        }
    </div>

    <!-- Zone de Saisie -->
    <div class="card-footer bg-white p-2 border-top">
        <form id="chatbot-form" onsubmit="handleChatSubmit(event)" class="d-flex gap-2">
            <input type="text" id="chatbot-input" class="form-control form-control-sm" placeholder="Posez votre question..." autocomplete="off" />
            <button type="submit" class="btn btn-primary btn-sm px-3">🚀</button>
        </form>
    </div>
</div>

<!-- Script JavaScript du Chatbot -->
<script>
    function toggleChatbot() {
        const chatWin = document.getElementById('chatbot-window');
        chatWin.classList.toggle('d-none');
        chatWin.classList.toggle('d-flex');
        if (!chatWin.classList.contains('d-none')) {
            document.getElementById('chatbot-input').focus();
        }
    }

    function sendQuickMessage(msg) {
        document.getElementById('chatbot-input').value = msg;
        handleChatSubmit(new Event('submit'));
    }

    async function handleChatSubmit(e) {
        e.preventDefault();
        const input = document.getElementById('chatbot-input');
        const message = input.value.trim();
        if (!message) return;

        const messagesContainer = document.getElementById('chatbot-messages');

        // 1. Affichage du message client
        const userMsgDiv = document.createElement('div');
        userMsgDiv.className = 'd-flex justify-content-end mb-2';
        userMsgDiv.innerHTML = `<div class="bg-primary text-white p-2 rounded shadow-sm" style="max-width: 85%; font-size: 13px;">${escapeHtml(message)}</div>`;
        messagesContainer.appendChild(userMsgDiv);

        input.value = '';
        messagesContainer.scrollTop = messagesContainer.scrollHeight;

        // 2. Animation "L'assistant écrit..."
        const typingDiv = document.createElement('div');
        typingDiv.id = 'bot-typing';
        typingDiv.className = 'd-flex align-items-start gap-2 mb-2';
        typingDiv.innerHTML = `<div class="bg-white p-2 rounded shadow-sm text-muted border fst-italic" style="font-size: 12px;">L'assistant écrit...</div>`;
        messagesContainer.appendChild(typingDiv);
        messagesContainer.scrollTop = messagesContainer.scrollHeight;

        try {
            const response = await fetch('/Chatbot/SendMessage', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ message: message })
            });

            const data = await response.json();
            document.getElementById('bot-typing')?.remove();

            // 3. Affichage de la réponse
            const botMsgDiv = document.createElement('div');
            botMsgDiv.className = 'd-flex align-items-start gap-2 mb-2';
            botMsgDiv.innerHTML = `<div class="bg-white p-2 rounded shadow-sm text-dark border" style="max-width: 85%; font-size: 13px;">${data.reply}</div>`;
            messagesContainer.appendChild(botMsgDiv);

            // 4. Mise à jour des boutons de suggestion
            const suggestionsContainer = document.getElementById('chatbot-suggestions');
            if (data.suggestions && data.suggestions.length > 0) {
                suggestionsContainer.innerHTML = data.suggestions
                    .map(s => `<button class="btn btn-outline-secondary btn-sm py-0 px-2" onclick="sendQuickMessage('${s.replace(/'/g, "\\'")}')">${s}</button>`)
                    .join('');
            }
        } catch (error) {
            document.getElementById('bot-typing')?.remove();
            const errorDiv = document.createElement('div');
            errorDiv.className = 'd-flex align-items-start gap-2 mb-2';
            errorDiv.innerHTML = `<div class="bg-danger text-white p-2 rounded shadow-sm" style="max-width: 85%; font-size: 13px;">Une erreur est survenue. Veuillez réessayer.</div>`;
            messagesContainer.appendChild(errorDiv);
        }

        messagesContainer.scrollTop = messagesContainer.scrollHeight;
    }

    function escapeHtml(text) {
        return text.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;").replace(/"/g, "&quot;").replace(/'/g, "&#039;");
    }
</script>