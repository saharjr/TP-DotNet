@model TP2.ViewModels.EditViewModel
@{
    ViewData["Title"] = "Edit";
    var photoPath = "~/images/" + (Model.ExistingImagePath ?? "noimage.jpg");
}

<h1>Edit</h1>
<h4>Product</h4>
<hr />

<form asp-controller="Product" asp-action="edit" enctype="multipart/form-data" method="post" class="mt-3">
    <div asp-validation-summary="All" class="text-danger"></div>
    <input hidden asp-for="ProductId" />
    <input hidden asp-for="ExistingImagePath" />

    <div class="form-group row mb-3">
        <label asp-for="Name" class="col-sm-2 col-form-label"></label>
        <div class="col-sm-10">
            <input asp-for="Name" class="form-control" />
            <span asp-validation-for="Name" class="text-danger"></span>
        </div>
    </div>
    <div class="form-group row mb-3">
        <label asp-for="Price" class="col-sm-2 col-form-label"></label>
        <div class="col-sm-10">
            <input asp-for="Price" class="form-control" />
            <span asp-validation-for="Price" class="text-danger"></span>
        </div>
    </div>
    <div class="form-group row mb-3">
        <label asp-for="QteStock" class="col-sm-2 col-form-label"></label>
        <div class="col-sm-10">
            <input asp-for="QteStock" class="form-control" />
            <span asp-validation-for="QteStock" class="text-danger"></span>
        </div>
    </div>
    <div class="form-group row mb-3">
        <label asp-for="CategoryId" class="col-sm-2 col-form-label"></label>
        <div class="col-sm-10">
            <select asp-for="CategoryId" class="form-control" asp-items="ViewBag.CategoryId"></select>
            <span asp-validation-for="CategoryId" class="text-danger"></span>
        </div>
    </div>
    <div class="form-group row mb-3">
        <label asp-for="ImagePath" class="col-sm-2 col-form-label"></label>
        <div class="col-sm-10">
            <input asp-for="ImagePath" class="custom-file-input form-control" id="imageInput">
        </div>
    </div>
    <div class="form-group row mb-3 text-center">
        <img id="imageEmp" src="@photoPath" asp-append-version="true" height="150" width="150" style="object-fit:contain;" />
    </div>
    <div class="form-group row">
        <div class="col-sm-10">
            <button type="submit" class="btn btn-primary">Update</button>
            <a asp-action="Index" asp-controller="Product" class="btn btn-secondary">Cancel</a>
        </div>
    </div>

    @section Scripts {
        <script>
            $(document).ready(function () {
                $('.custom-file-input').on("change", function () {
                    var fileName = $(this).val().split("\\").pop();
                    var reader = new FileReader();
                    reader.onload = function (e) {
                        $('#imageEmp').attr('src', e.target.result);
                    };
                    reader.readAsDataURL(this.files[0]);
                });
            });
        </script>
    }
</form>