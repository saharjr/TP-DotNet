@model TP2.Models.Product

@{
    ViewData["Title"] = "Détails - " + Model.Name;
    var photoPath = "~/images/" + (Model.Image ?? "noimage.jpg");
}

<div class="container py-3">
    <!-- Fiche Produit -->
    <div class="card shadow-sm border-0 mb-4">
        <div class="row g-0 align-items-center">
            <div class="col-md-5 text-center p-3">
                <img src="@photoPath" class="img-fluid rounded" style="max-height: 300px; object-fit: contain;" asp-append-version="true" />
            </div>
            <div class="col-md-7">
                <div class="card-body">
                    <h2 class="card-title text-primary">@Model.Name</h2>
                    <p class="text-muted">Catégorie : <strong>@(Model.Category?.CategoryName)</strong></p>
                    <h3 class="text-success fw-bold">@Model.Price DT</h3>
                    <p>Stock disponible : <strong>@Model.QteStock</strong> unités</p>

                    <!-- Étoiles & Note Moyenne -->
                    <div class="mb-3">
                        <span class="fs-4 text-warning">
                            @for (int i = 1; i <= 5; i++)
                            {
                                if (i <= Math.Round(Model.AverageRating))
                                {
                                    <span>★</span>
                                }
                                else
                                {
                                    <span class="text-secondary">☆</span>
                                }
                            }
                        </span>
                        <span class="fw-bold ms-2">@Model.AverageRating / 5</span>
                        <span class="text-muted">(@Model.Reviews.Count avis)</span>
                    </div>

                    @if (!User.IsInRole("Admin"))
                    {
                        <a asp-controller="Panier" asp-action="AddProduct" asp-route-id="@Model.ProductId" class="btn btn-success btn-lg">
                            🛒 Ajouter Au Panier
                        </a>
                    }
                    <a asp-action="Index" class="btn btn-outline-secondary btn-lg ms-2">Retour</a>
                </div>
            </div>
        </div>
    </div>

    <!-- Section Avis & Commentaires -->
    <div class="row g-4">
        <div class="col-md-5">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0">Laisser un avis</h5>
                </div>
                <div class="card-body">
                    @if (User.Identity.IsAuthenticated)
                    {
                        <form asp-action="AddReview" method="post">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="productId" value="@Model.ProductId" />

                            <div class="mb-3">
                                <label class="form-label fw-semibold">Note :</label>
                                <select name="rating" class="form-select" required>
                                    <option value="5">⭐⭐⭐⭐⭐ (5/5) - Excellent</option>
                                    <option value="4">⭐⭐⭐⭐☆ (4/5) - Très bon</option>
                                    <option value="3">⭐⭐⭐☆☆ (3/5) - Moyen</option>
                                    <option value="2">⭐⭐☆☆☆ (2/5) - Décevant</option>
                                    <option value="1">⭐☆☆☆☆ (1/5) - Mauvais</option>
                                </select>
                            </div>

                            <div class="mb-3">
                                <label class="form-label fw-semibold">Votre commentaire :</label>
                                <textarea name="comment" class="form-control" rows="4" placeholder="Votre avis sur ce produit..." required></textarea>
                            </div>

                            <button type="submit" class="btn btn-primary w-100">Publier mon avis</button>
                        </form>
                    }
                    else
                    {
                        <div class="text-center py-3">
                            <p class="text-muted">Connectez-vous pour déposer un avis.</p>
                            <a asp-controller="Account" asp-action="Login" class="btn btn-outline-primary">Se connecter</a>
                        </div>
                    }
                </div>
            </div>
        </div>

        <div class="col-md-7">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-dark text-white">
                    <h5 class="mb-0">Avis des clients (@Model.Reviews.Count)</h5>
                </div>
                <div class="card-body">
                    @if (!Model.Reviews.Any())
                    {
                        <p class="text-muted text-center py-3">Aucun avis pour le moment.</p>
                    }
                    else
                    {
                        @foreach (var review in Model.Reviews.OrderByDescending(r => r.ReviewDate))
                        {
                            <div class="border-bottom pb-3 mb-3">
                                <div class="d-flex justify-content-between align-items-center mb-1">
                                    <strong>@review.UserName</strong>
                                    <small class="text-muted">@review.ReviewDate.ToString("dd/MM/yyyy HH:mm")</small>
                                </div>
                                <div class="text-warning mb-2">
                                    @for (int i = 1; i <= 5; i++)
                                    {
                                        if (i <= review.Rating)
                                        {
                                            <span>★</span>
                                        }
                                        else
                                        {
                                            <span class="text-secondary">☆</span>
                                        }
                                    }
                                </div>
                                <p class="mb-0 text-dark">@review.Comment</p>
                            </div>
                        }
                    }
                </div>
            </div>
        </div>
    </div>
</div>