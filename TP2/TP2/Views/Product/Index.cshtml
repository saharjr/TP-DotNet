@model IEnumerable<TP2.Models.Product>

@{
    ViewData["Title"] = "Liste des produits";
}

<h2>Liste des produits</h2>

@if (User.IsInRole("Admin") || User.IsInRole("Manager"))
{
    <p>
        <a asp-action="Create" class="btn btn-primary">Nouvel Article</a>
    </p>
}

<div class="d-flex flex-wrap">
    @foreach (var product in Model)
    {
        var photoPath = "~/images/" + (product.Image ?? "noimage.jpg");
        <div class="card m-2" style="width: 18rem;">
            <div class="card-header text-center">
                <h5><b>Nom: </b>@product.Name</h5>
            </div>
            <img class="card-img-top imageThumbnail" src="@photoPath" asp-append-version="true" style="height:200px; object-fit:contain;" />
            <div class="card-body">
                <p class="card-text"><b>Prix: </b>@product.Price DT</p>
                <p class="card-text"><b>Quantité: </b>@product.QteStock</p>
                <p class="card-text"><b>Catégorie: </b>@(product.Category?.CategoryName)</p>
            </div>
            <div class="card-footer text-center">
                <!-- Le bouton Détails est visible par tout le monde -->
                <a asp-controller="Product" asp-action="Details" asp-route-id="@product.ProductId" class="btn btn-success btn-sm">Détails</a>

                <!-- Afficher "Ajouter Au Panier" UNIQUEMENT si l'utilisateur N'EST PAS Admin -->
                @if (!User.IsInRole("Admin"))
                {
                    <a asp-controller="Panier" asp-action="AddProduct" asp-route-id="@product.ProductId" class="btn btn-outline-secondary btn-sm">Ajouter Au Panier</a>
                }

                <!-- Les boutons Edit/Delete réservés à Admin et Manager -->
                @if (User.IsInRole("Admin") || User.IsInRole("Manager"))
                {
                    <div class="mt-2">
                        <a asp-action="Edit" asp-controller="Product" asp-route-id="@product.ProductId" class="btn btn-warning btn-sm">Edit</a>
                        <a asp-action="Delete" asp-controller="Product" asp-route-id="@product.ProductId" class="btn btn-danger btn-sm">Delete</a>
                    </div>
                }
            </div>
        </div>
    }
</div>

<!-- Pagination -->
<div class="pagination mt-4 d-flex justify-content-center">
    @if (ViewBag.TotalPages != null)
    {
        for (int i = 1; i <= ViewBag.TotalPages; i++)
        {
            <a asp-action="Index"
               asp-route-categoryId="@ViewBag.CategoryId"
               asp-route-page="@i"
               class="btn @(i == ViewBag.CurrentPage ? "btn-primary" : "btn-outline-secondary") m-1">
                @i
            </a>
        }
    }
</div>