@{
    ViewData["Title"] = "Accueil - E-Commerce Store";
}

<!-- Section Hero / Bannières Principale -->
<div class="p-5 mb-4 bg-light rounded-3 border shadow-sm text-center">
    <div class="container-fluid py-3">
        <h1 class="display-4 fw-bold text-primary mb-3">Bienvenue sur Notre E-Shop 🛍️</h1>
        <p class="col-md-8 fs-4 mx-auto text-secondary mb-4">
            Découvrez une sélection exclusive de produits de qualité aux meilleurs prix. Commandez en ligne en toute sécurité et faites-vous livrer chez vous !
        </p>
        <div class="d-flex justify-content-center gap-3">
            <a asp-controller="Product" asp-action="Index" class="btn btn-primary btn-lg px-4 shadow-sm fw-bold">
                🛒 Explorer le Catalogue
            </a>
            @if (!User.Identity.IsAuthenticated)
            {
                <a asp-controller="Account" asp-action="Register" class="btn btn-outline-primary btn-lg px-4">
                    Créer un Compte
                </a>
            }
        </div>
    </div>
</div>

<!-- Section Avantages / Services -->
<div class="row g-4 py-3 text-center">
    <div class="col-md-3">
        <div class="card h-100 border-0 shadow-sm p-3">
            <div class="fs-1 text-primary mb-2">🚚</div>
            <h5 class="fw-bold">Livraison Rapide</h5>
            <p class="text-muted small mb-0">Expédition rapide et sécurisée à votre domicile partout en Tunisie.</p>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card h-100 border-0 shadow-sm p-3">
            <div class="fs-1 text-success mb-2">🔒</div>
            <h5 class="fw-bold">Paiement Sécurisé</h5>
            <p class="text-muted small mb-0">Transactions totalement sécurisées pour toutes vos commandes.</p>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card h-100 border-0 shadow-sm p-3">
            <div class="fs-1 text-warning mb-2">⭐</div>
            <h5 class="fw-bold">Avis Vrais & Vérifiés</h5>
            <p class="text-muted small mb-0">Consultez les notes et les commentaires laissés par nos clients.</p>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card h-100 border-0 shadow-sm p-3">
            <div class="fs-1 text-info mb-2">🎧</div>
            <h5 class="fw-bold">Support Client 7/7</h5>
            <p class="text-muted small mb-0">Une équipe réactive à votre disposition pour vous accompagner.</p>
        </div>
    </div>
</div>

<!-- Cartes d'Accès Rapide -->
<div class="row g-4 mt-2">
    <div class="col-md-6">
        <div class="card bg-primary text-white shadow-sm border-0 rounded-3 p-4">
            <h3>📦 Nos Articles</h3>
            <p class="mb-3">Parcourez notre catalogue, filtrez par catégories et vérifiez le stock en temps réel.</p>
            <div>
                <a asp-controller="Product" asp-action="Index" class="btn btn-light text-primary fw-bold">
                    Voir les produits →
                </a>
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card bg-dark text-white shadow-sm border-0 rounded-3 p-4">
            <h3>🛍️ Espace Personnel</h3>
            <p class="mb-3">Accédez à votre historique de commandes, téléchargez vos factures PDF et déposez vos avis.</p>
            <div>
                @if (User.Identity.IsAuthenticated)
                {
                    <a asp-controller="Order" asp-action="MesCommandes" class="btn btn-outline-light fw-bold">
                        Mes Commandes →
                    </a>
                }
                else
                {
                    <a asp-controller="Account" asp-action="Login" class="btn btn-outline-light fw-bold">
                        Se connecter →
                    </a>
                }
            </div>
        </div>
    </div>
</div>