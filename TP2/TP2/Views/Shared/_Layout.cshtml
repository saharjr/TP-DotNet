@using Microsoft.AspNetCore.Identity
@inject SignInManager<IdentityUser> SignInManager

<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - E-Commerce</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <!-- Bouton d'ouverture du menu latéral -->
                <button class="btn btn-outline-primary me-2" id="toggleMenu">
                    <img src="~/images/categorie.png" alt="Ouvrir la liste des catégories" style="width:24px; height:24px;" />
                </button>

                <a class="navbar-brand" asp-controller="Product" asp-action="Index">Gestion des Articles</a>

                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-controller="Home" asp-action="Index">Home</a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-controller="Product" asp-action="Index">Liste d'articles</a>
                        </li>

                        <!-- Lien Catégories : Visible par TOUS (Admin + Users) -->
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-controller="Category" asp-action="Index">Catégories</a>
                        </li>

                        <!-- Menu Administration : Visible UNIQUEMENT par l'Admin -->
                        @if (SignInManager.IsSignedIn(User) && User.IsInRole("Admin"))
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle text-dark" data-bs-toggle="dropdown" href="#">Administration</a>
                                <div class="dropdown-menu">
                                    <a class="dropdown-item" asp-controller="Admin" asp-action="CreateRole">Create Role</a>
                                    <a class="dropdown-item" asp-controller="Admin" asp-action="ListRoles">List Roles</a>
                                    <div class="dropdown-divider"></div>
                                    <a class="dropdown-item" asp-controller="Category" asp-action="Create">Créer une Catégorie</a>
                                </div>
                            </li>
                        }

                        <!-- Mon Panier : Masqué pour l'Admin -->
                        @if (!User.IsInRole("Admin"))
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-controller="Panier" asp-action="Index">Mon Panier</a>
                            </li>
                        }
                    </ul>

                    <form class="d-flex me-3" asp-controller="Product" asp-action="Search">
                        <input class="form-control me-sm-2" type="search" placeholder="Search" name="val">
                        <button class="btn btn-secondary" type="submit">Search</button>
                    </form>

                    <ul class="navbar-nav">
                        @if (SignInManager.IsSignedIn(User))
                        {
                            <li class="nav-item">
                                <form method="post" asp-controller="Account" asp-action="Logout">
                                    <button type="submit" class="nav-link btn btn-link text-dark py-0 my-2">
                                        Logout @User.Identity.Name
                                    </button>
                                </form>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item"><a class="nav-link text-dark" asp-controller="Account" asp-action="Register">Register</a></li>
                            <li class="nav-item"><a class="nav-link text-dark" asp-controller="Account" asp-action="Login">Login</a></li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <div class="container-fluid">
        <div class="row">
            <!-- Menu latéral catégories -->
            <div class="col-md-2" id="sidebar" style="display: none;">
                @await Html.PartialAsync("_CategoriesMenu", ViewData["Categories"] as IEnumerable<TP2.Models.Category>)
            </div>

            <!-- Contenu principal -->
            <div class="col-md-12" id="mainContent">
                <main role="main" class="pb-3">
                    @RenderBody()
                </main>
            </div>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>